{
  "name": "mastra-w-client_server",
  "version": "1.0.0",
  "description": "An Express.js + TypeScript boilerplate",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "studio": "mastra studio -p 4211 -s 3000",
    "dev:studio": "concurrently -k -s first -n APP,STUDIO -c blue,green \"pnpm run dev\" \"pnpm run studio\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastra-ai/express-ts-boilerplate.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/mastra-ai/express-ts-boilerplate/issues"
  },
  "homepage": "https://github.com/mastra-ai/express-ts-boilerplate#readme",
  "dependencies": {
    "@mastra/ai-sdk": "^1.0.4",
    "@mastra/core": "^1.4.0",
    "@mastra/express": "^1.1.3",
    "@mastra/libsql": "^1.4.0",
    "@mastra/loggers": "^1.0.1",
    "@mastra/memory": "^1.3.0",
    "@mastra/observability": "^1.2.0",
    "@t3-oss/env-core": "^0.13.10",
    "ai": "^6.0.86",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mastra": "^1.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.2",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
